# Environment template for App Factory container-only MVP (E2-T1, E3-T1, ADR 0073).
# Copy to `.env.factory` (or `.env`) and fill real credentials before starting:
#
#   docker compose -f compose.yaml -f compose.live.yaml -f compose.factory.yaml --env-file .env.factory --profile app up -d --build --wait
#
# Never commit real secrets. Validate offline without starting containers:
#
#   docker compose -f compose.yaml -f compose.live.yaml -f compose.factory.yaml --env-file .env.factory.example config -q

# ---- Edge TLS ports & internal CA trust (bound to 127.0.0.1; never uses port 80) -------------------------
EDGE_HTTP_PORT=8080
EDGE_HTTPS_PORT=8443
# When Caddy serves `:8443` with `tls internal`, `edge` exports its local root CA to `/etc/caddy-ca/root.crt`
# so container-to-container HTTPS (`https://edge:8443` for thread-tools and factory-mcp) trusts it alongside
# system CAs. For real external/ACME certs, `/etc/caddy-ca` remains empty and system CAs in `/etc/ssl/certs` apply.
SSL_CERT_DIR=/etc/ssl/certs:/etc/caddy-ca

# ---- Real OIDC provider behind Caddy TLS (oauth2-proxy + factory-board + factory-mcp) ----------------------
OAUTH2_PROXY_OIDC_ISSUER_URL=https://auth.example.test
OAUTH2_PROXY_CLIENT_ID=factory-web
OAUTH2_PROXY_CLIENT_SECRET=replace-with-oidc-client-secret
# Exactly 16, 24, or 32 bytes base64-encoded (`openssl rand -base64 32 | tr -- '+/' '-_'`)
OAUTH2_PROXY_COOKIE_SECRET=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
OAUTH2_PROXY_COOKIE_SECURE=true
# Optional override when JWKS URL differs from ${OAUTH2_PROXY_OIDC_ISSUER_URL}/.well-known/jwks.json
# OIDC_JWKS_URL=https://auth.example.test/.well-known/jwks.json
OIDC_AUDIENCE=factory-web
# Point orchestrator at your tenant YAML containing the matching auth.jwt.issuer / audiences:
ORCH_FACTORY_CONFIG_FILE=./dev/orchestrator.factory.yaml

# ---- Postgres password (shared across postgres, agents-postgres, coder-postgres) ---------------------------
POSTGRES_PASSWORD=replace-with-postgres-password-0123456789abcdef

# ---- Model endpoint & model-pinned agent containers (E3-T1) ------------------------------------------------
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=replace-with-model-api-key
MODEL=replace-with-default-model
ARCHITECT_MODEL=replace-with-architect-reasoning-model
CODER_FAST_MODEL=replace-with-fast-coding-model
CODER_LIGHT_MODEL=replace-with-light-utility-model
TITLE_MODEL=replace-with-title-model
# Optional agent folder overrides (parent dirs containing `agent/instructions.md` & `agent/mcp.json`).
# Note: `adam-coder-fast` and `adam-coder-light` run `adam-coder`, which requires `name: coder` in the
# mounted root `agent/instructions.md` (custom specialist prompts/subagents go under `agent/subagents/`
# or in the body while keeping `name: coder`).
# ARCHITECT_AGENT_DIR=./dev/agents/architect/agent
# CODER_FAST_AGENT_DIR=./dev/coder/agent
# CODER_LIGHT_AGENT_DIR=./dev/coder/agent

# ---- Per-agent A2A bearer tokens (32+ random bytes each: `openssl rand -hex 32`) --------------------------
ARCHITECT_A2A_TOKEN=replace-me-architect-a2a-token-0123456789abcdef0123456789abcdef
CODER_FAST_A2A_TOKEN=replace-me-coder-fast-a2a-token-0123456789abcdef0123456789abcdef
CODER_LIGHT_A2A_TOKEN=replace-me-coder-light-a2a-token-0123456789abcdef0123456789abcdef
CODER_A2A_TOKEN=replace-me-coder-a2a-token-0123456789abcdef0123456789abcdef
CHAT_A2A_TOKEN=replace-me-chat-a2a-token-0123456789abcdef0123456789abcdef
RESEARCHER_A2A_TOKEN=replace-me-researcher-a2a-token-0123456789abcdef0123456789abcdef
BROWSER_A2A_TOKEN=replace-me-browser-a2a-token-0123456789abcdef0123456789abcdef

# ---- Orchestrator, MCP, and Webhook secrets (32+ random bytes each) ----------------------------------------
OBSCURA_MCP_TOKEN=replace-me-obscura-mcp-token-0123456789abcdef0123456789abcdef
MCP_TOKEN_DEV=replace-me-mcp-token-dev-0123456789abcdef0123456789abcdef
THREAD_TOOLS_SECRET=replace-me-thread-tools-secret-0123456789abcdef0123456789abcdef
SHARING_SECRET=replace-me-sharing-secret-0123456789abcdef0123456789abcdef
USER_SECRETS_KEY=d1aaf3f7a4590737a57d1f96950d96e9d0e0b57471ac8421f7cff79ee63f6cff
GITHUB_WEBHOOK_SECRET=replace-me-github-webhook-secret-0123456789abcdef0123456789abcdef
WEBHOOK_GITHUB_SECRETS=replace-me-github-webhook-secret-0123456789abcdef0123456789abcdef
DEPLOY_WEBHOOK_SECRET=replace-me-deploy-webhook-secret-0123456789abcdef0123456789abcdef
# WARNING: Live `factory-mcp` calls require a real OIDC bearer JWT issued by OAUTH2_PROXY_OIDC_ISSUER_URL
# with audience OIDC_AUDIENCE. The placeholder value below only prevents empty-header startup errors;
# `factory-mcp` is marked `"optional": true` in `mcp.json` so `adam-architect` starts cleanly without it,
# but `factory-mcp` tools will be unavailable until a valid OIDC token is supplied.
FACTORY_MCP_TOKEN=replace-with-factory-mcp-oidc-token

# ---- GitHub access for coding agents & factory-mcp ---------------------------------------------------------
GITHUB_TOKEN=github_pat_replace_with_your_token
GITHUB_API_URL=https://api.github.com
ALLOWED_REPO_HOSTS=github.com
BLUEPRINT_SOURCE_URL=https://github.com/vymalo/app-factory-blueprint.git
